{
  "$schema": "https://champiq.dev/manifest/v2.json",
  "manifest_version": 2,
  "tool_id": "champmail",
  "name": "Champmail",
  "description": "Cold email sequences, reply detection, analytics.",
  "category": "outreach",
  "color": "#6366F1",
  "icon": "mail",
  "credentials_required": ["champmail"],
  "actions": [
    {
      "id": "send",
      "label": "Send Email",
      "description": "Send one email through ChampMail's real auth+suppression-checked send API (2026-07-27 consolidation — replaces the removed inline ChampmailLocalExecutor/Emelia path).",
      "input_schema": {
        "type": "object",
        "required": ["to", "subject", "html_body"],
        "properties": {
          "to": {"type": "string", "format": "email"},
          "from_name": {"type": "string"},
          "from_address": {"type": "string"},
          "subject": {"type": "string"},
          "html_body": {"type": "string"},
          "text_body": {"type": "string"},
          "reply_to": {"type": "string"},
          "domain_id": {"type": "string"},
          "track_opens": {"type": "boolean"},
          "track_clicks": {"type": "boolean"}
        }
      }
    },
    {
      "id": "send_batch",
      "label": "Send Batch",
      "input_schema": {
        "type": "object",
        "required": ["emails"],
        "properties": {
          "emails": {"type": "array"},
          "domain_id": {"type": "string"}
        }
      }
    },
    {
      "id": "get_status",
      "label": "Get Send Status",
      "input_schema": {
        "type": "object",
        "required": ["message_id"],
        "properties": {"message_id": {"type": "string"}}
      }
    },
    {
      "id": "get_stats",
      "label": "Get Send Stats",
      "input_schema": {
        "type": "object",
        "properties": {"domain_id": {"type": "string"}}
      }
    }
  ],
  "triggers": [
    {"kind": "event", "event": "email.replied", "label": "On Email Replied"},
    {"kind": "event", "event": "email.opened", "label": "On Email Opened"},
    {"kind": "event", "event": "email.clicked", "label": "On Email Clicked"},
    {"kind": "event", "event": "email.bounced", "label": "On Email Bounced"},
    {"kind": "event", "event": "sequence.completed", "label": "On Sequence Completed"}
  ]
}
