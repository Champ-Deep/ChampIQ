{
  "$schema": "https://champiq.dev/manifest/v2.json",
  "manifest_version": 2,
  "tool_id": "champmail",
  "name": "Champmail",
  "description": "Cold email sequences, prospects, templates, suppressions, sending and analytics \u2014 the full ChampMail surface. Sends route through ChampMail's real send API, which applies mailbox rotation, per-mailbox daily caps, suppression checks and Message-ID correlation.",
  "category": "outreach",
  "color": "#6366F1",
  "icon": "mail",
  "credentials_required": [
    "champmail"
  ],
  "actions": [
    {
      "id": "send",
      "label": "Send Email",
      "description": "Send one email through ChampMail's real auth+suppression-checked send API (2026-07-27 consolidation \u2014 replaces the removed inline ChampmailLocalExecutor/Emelia path).",
      "input_schema": {
        "type": "object",
        "required": [
          "to",
          "subject",
          "html_body"
        ],
        "properties": {
          "to": {
            "type": "string",
            "format": "email"
          },
          "from_name": {
            "type": "string"
          },
          "from_address": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "html_body": {
            "type": "string"
          },
          "text_body": {
            "type": "string"
          },
          "reply_to": {
            "type": "string"
          },
          "domain_id": {
            "type": "string"
          },
          "track_opens": {
            "type": "boolean"
          },
          "track_clicks": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "id": "send_batch",
      "label": "Send Batch",
      "input_schema": {
        "type": "object",
        "required": [
          "emails"
        ],
        "properties": {
          "emails": {
            "type": "array"
          },
          "domain_id": {
            "type": "string"
          }
        }
      },
      "description": "Send many emails in one call through ChampMail's send API. NOTE: the batch task does not yet support InboxKit-provisioned domains \u2014 it always uses the Go mail-engine. For an InboxKit domain, loop `send` per prospect instead."
    },
    {
      "id": "get_status",
      "label": "Get Send Status",
      "input_schema": {
        "type": "object",
        "required": [
          "message_id"
        ],
        "properties": {
          "message_id": {
            "type": "string"
          }
        }
      },
      "description": "Delivery status for one message by its Message-ID. Message-IDs are generated by ChampMail before send, so they correlate with replies and bounces."
    },
    {
      "id": "get_stats",
      "label": "Get Send Stats",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain_id": {
            "type": "string"
          }
        }
      },
      "description": "Aggregate send statistics \u2014 volume, delivery and bounce counts across the account."
    },
    {
      "id": "list_sequences",
      "label": "List Sequences",
      "description": "All sequences with step counts and enabled state.",
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {}
      }
    },
    {
      "id": "create_sequence",
      "label": "Create Sequence",
      "description": "Create a multi-step cadence. 4-7 steps spaced 3-5 days apart is the benchmarked sweet spot; each follow-up should add new value rather than bump the last one.",
      "input_schema": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "id": "get_sequence",
      "label": "Get Sequence",
      "description": "One sequence with its steps.",
      "input_schema": {
        "type": "object",
        "required": [
          "sequence_id"
        ],
        "properties": {
          "sequence_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "enroll_sequence",
      "label": "Enrol Prospect in Sequence",
      "description": "The action signal-triggered outreach is built on: a signal fires, a DAG enrols the prospect. Suppression is enforced by ChampMail on enrolment, so a suppressed address cannot be re-entered.",
      "input_schema": {
        "type": "object",
        "required": [
          "sequence_id"
        ],
        "properties": {
          "sequence_id": {
            "type": "string"
          },
          "prospect_email": {
            "type": "string",
            "format": "email"
          },
          "prospect_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "pause_sequence",
      "label": "Pause Sequence",
      "description": "Halt a cadence. The standard use is halt-on-reply: a positive reply should stop the remaining steps immediately.",
      "input_schema": {
        "type": "object",
        "required": [
          "sequence_id"
        ],
        "properties": {
          "sequence_id": {
            "type": "string"
          },
          "prospect_email": {
            "type": "string",
            "format": "email"
          },
          "enrollment_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "resume_sequence",
      "label": "Resume Sequence",
      "description": "Resume a paused cadence.",
      "input_schema": {
        "type": "object",
        "required": [
          "sequence_id"
        ],
        "properties": {
          "sequence_id": {
            "type": "string"
          },
          "enrollment_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "get_sequence_analytics",
      "label": "Sequence Analytics",
      "description": "Sends, opens, clicks, replies, bounces and derived rates for one sequence.",
      "input_schema": {
        "type": "object",
        "required": [
          "sequence_id"
        ],
        "properties": {
          "sequence_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "suppress",
      "label": "Suppress Address",
      "description": "Add an address to the suppression list. A reply or unsubscribe handler that cannot suppress is not a handler \u2014 this is what makes an opt-out actually stick across every future campaign.",
      "input_schema": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "check_suppression",
      "label": "Check Suppression",
      "description": "Whether an address is suppressed. Use as a guard before enrolling from an external list.",
      "input_schema": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    {
      "id": "list_prospects",
      "label": "List Prospects",
      "description": "Paginated prospects, filterable by status and free-text search.",
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "search": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "add_prospect",
      "label": "Add Prospect",
      "description": "Create or upsert a prospect by email.",
      "input_schema": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "get_prospect",
      "label": "Get Prospect",
      "description": "Look up one prospect by email address.",
      "input_schema": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    {
      "id": "update_prospect",
      "label": "Update Prospect",
      "description": "Patch a prospect's fields by email.",
      "input_schema": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "bulk_import_prospects",
      "label": "Bulk Import Prospects",
      "description": "Import many prospects in one call \u2014 the entry point for a Harbinger or ChampSet handoff.",
      "input_schema": {
        "type": "object",
        "required": [
          "prospects"
        ],
        "properties": {
          "prospects": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "id": "get_prospect_timeline",
      "label": "Prospect Timeline",
      "description": "One prospect's cross-channel history. The read a DAG needs before deciding whether to contact someone again.",
      "input_schema": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    {
      "id": "list_templates",
      "label": "List Templates",
      "description": "All email templates with their variables.",
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {}
      }
    },
    {
      "id": "create_template",
      "label": "Create Template",
      "description": "Create a template. 50-125 words is the highest-responding length band.",
      "input_schema": {
        "type": "object",
        "required": [
          "name",
          "subject"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body_html": {
            "type": "string"
          },
          "body_text": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "get_template",
      "label": "Get Template",
      "description": "One template by id.",
      "input_schema": {
        "type": "object",
        "required": [
          "template_id"
        ],
        "properties": {
          "template_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "preview_template",
      "label": "Preview Template",
      "description": "Render a template against variables without sending. Use to validate personalisation before a campaign goes out.",
      "input_schema": {
        "type": "object",
        "required": [
          "template_id"
        ],
        "properties": {
          "template_id": {
            "type": "string"
          },
          "variables": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "list_domains",
      "label": "List Sending Domains",
      "description": "Sending domains with their daily limits, sent counts and infra provider.",
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {}
      }
    }
  ],
  "triggers": [
    {
      "kind": "event",
      "event": "email.replied",
      "label": "On Email Replied"
    },
    {
      "kind": "event",
      "event": "email.opened",
      "label": "On Email Opened"
    },
    {
      "kind": "event",
      "event": "email.clicked",
      "label": "On Email Clicked"
    },
    {
      "kind": "event",
      "event": "email.bounced",
      "label": "On Email Bounced"
    },
    {
      "kind": "event",
      "event": "sequence.completed",
      "label": "On Sequence Completed"
    }
  ]
}
